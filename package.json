{
  "name": "task-manager",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm --filter @tm/web build",
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @tm/api db:generate",
    "db:migrate:local": "pnpm --filter @tm/api db:migrate:local",
    "db:migrate:remote": "pnpm --filter @tm/api db:migrate:remote",
    "deploy": "pnpm build && pnpm --filter @tm/api run deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "5.9.3"
  }
}
